#!/usr/bin/env python3
"""Refresh generated Darth SSH source pillar from a GitHub/raw source.

This runs on the Salt master. It lets the firewall host pull the current Darth
SSH source from an outbound HTTPS source, avoiding the lockout problem where a
new Darth IP could not SSH in to update the firewall after the old IP is denied.
"""
from __future__ import annotations

import ipaddress
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.request import Request, urlopen

CONFIG = {{ update_config | json }}
CIDR_RE = re.compile(r'(?<![0-9A-Fa-f:.])(?:[0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}(?![0-9A-Fa-f:.])')


def log(message: str) -> None:
    print(message, flush=True)


def run(cmd: list[str], check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=check)


def fetch(url: str) -> str:
    req = Request(url, headers={'User-Agent': 'redsalt-firewall-refresh/1.0'})
    with urlopen(req, timeout=30) as response:
        if response.status >= 400:
            raise RuntimeError(f'{url} returned HTTP {response.status}')
        return response.read().decode('utf-8')


def validate_pillar(text: str) -> list[str]:
    cidrs = CIDR_RE.findall(text)
    if not cidrs:
        raise RuntimeError('no IPv4 CIDR entries found in fetched Darth SSH source pillar')
    normalized = []
    for cidr in cidrs:
        network = ipaddress.ip_network(cidr, strict=False)
        if network.version != 4:
            raise RuntimeError(f'non-IPv4 CIDR is not allowed for Darth SSH source: {cidr}')
        if network.prefixlen < 32:
            raise RuntimeError(f'Darth SSH source must be a single IPv4 /32, got: {cidr}')
        normalized.append(str(network))
    if 'firewall_dynamic:' not in text or 'darth_ssh_sources:' not in text:
        raise RuntimeError('fetched pillar missing firewall_dynamic:darth_ssh_sources keys')
    return normalized


def main() -> int:
    url = CONFIG.get('source_url')
    target = Path(CONFIG.get('generated_pillar_path', '/srv/redsalt-master/pillar/generated/darth_ssh_source.sls'))
    apply_target = CONFIG.get('apply_target', '*')
    if not url:
        log('source_url is empty; nothing to refresh')
        return 0

    text = fetch(url)
    cidrs = validate_pillar(text)
    old = target.read_text() if target.exists() else ''
    if old == text:
        log(f'Darth SSH source unchanged: {", ".join(cidrs)}')
        return 0

    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile('w', delete=False, dir=str(target.parent)) as handle:
        handle.write(text)
        tmp_name = handle.name
    os.chmod(tmp_name, 0o644)
    shutil.move(tmp_name, target)
    log(f'updated {target} with Darth SSH source: {", ".join(cidrs)}')

    run(['salt-run', 'fileserver.update'])
    run(['salt', apply_target, 'saltutil.refresh_pillar'], check=False)
    result = run(['salt', '-t', '120', apply_target, 'state.apply', 'firewall'], check=False)
    log(result.stdout)
    if result.returncode != 0:
        raise RuntimeError(f'salt firewall apply returned {result.returncode}')
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f'ERROR: {exc}', file=sys.stderr)
        raise SystemExit(1)
