[Unit]
Description=vLLM OpenAI-compatible API container
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ compose_dir }}
ExecStartPre={{ triton_cache_cleanup_script }}
ExecStart=/usr/bin/docker compose -f {{ compose_dir }}/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f {{ compose_dir }}/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
